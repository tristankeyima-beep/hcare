{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Intervention Plan H5 Demo Schema",
  "type": "object",
  "required": [
    "planName",
    "planTitle",
    "planSummary",
    "executionPoints",
    "groups"
  ],
  "additionalProperties": false,
  "properties": {
    "planName": {
      "type": "string",
      "minLength": 1
    },
    "planTitle": {
      "type": "string",
      "minLength": 1
    },
    "planSummary": {
      "type": "string"
    },
    "executionPoints": {
      "type": "string"
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/adviceGroup"
          },
          {
            "$ref": "#/$defs/weeklyMealPlanGroup"
          }
        ]
      }
    }
  },
  "$defs": {
    "importance": {
      "type": "string",
      "enum": [
        "重点执行",
        "常规建议",
        "补充建议"
      ]
    },
    "numberValue": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "const": ""
        }
      ]
    },
    "dayValue": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 7
        },
        {
          "const": ""
        }
      ]
    },
    "adviceGroup": {
      "type": "object",
      "required": [
        "groupTitle",
        "groupType",
        "groupSummary",
        "displayStyle",
        "dietPlanGoalLabel",
        "goalBasis",
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "groupTitle": {
          "type": "string",
          "minLength": 1
        },
        "groupType": {
          "const": "adviceList"
        },
        "groupSummary": {
          "type": "string"
        },
        "displayStyle": {
          "type": "string"
        },
        "dietPlanGoalLabel": {
          "type": "string"
        },
        "goalBasis": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/adviceItem"
          }
        }
      }
    },
    "adviceItem": {
      "type": "object",
      "required": [
        "itemType",
        "day",
        "title",
        "content",
        "focusPoint",
        "importance",
        "dailyTotalKcal",
        "dailyTotalProteinG",
        "dailyTotalFatG",
        "dailyTotalCarbsG",
        "estimatedEnergyDeficitKcal",
        "meals"
      ],
      "additionalProperties": false,
      "properties": {
        "itemType": {
          "const": "advice"
        },
        "title": {
          "type": "string"
        },
        "day": {
          "$ref": "#/$defs/dayValue"
        },
        "content": {
          "type": "string",
          "minLength": 1
        },
        "focusPoint": {
          "type": "string",
          "minLength": 1
        },
        "importance": {
          "$ref": "#/$defs/importance"
        },
        "dailyTotalKcal": {
          "$ref": "#/$defs/numberValue"
        },
        "dailyTotalProteinG": {
          "$ref": "#/$defs/numberValue"
        },
        "dailyTotalFatG": {
          "$ref": "#/$defs/numberValue"
        },
        "dailyTotalCarbsG": {
          "$ref": "#/$defs/numberValue"
        },
        "estimatedEnergyDeficitKcal": {
          "$ref": "#/$defs/numberValue"
        },
        "meals": {
          "type": "array"
        }
      }
    },
    "weeklyMealPlanGroup": {
      "type": "object",
      "required": [
        "groupTitle",
        "groupType",
        "groupSummary",
        "displayStyle",
        "dietPlanGoalLabel",
        "goalBasis",
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "groupTitle": {
          "type": "string",
          "minLength": 1
        },
        "groupType": {
          "const": "weeklyMealPlan"
        },
        "groupSummary": {
          "type": "string"
        },
        "displayStyle": {
          "const": "weeklyMealPlan"
        },
        "dietPlanGoalLabel": {
          "type": "string",
          "minLength": 1
        },
        "goalBasis": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {
            "$ref": "#/$defs/dailyMealPlanItem"
          }
        }
      }
    },
    "dailyMealPlanItem": {
      "type": "object",
      "required": [
        "itemType",
        "day",
        "title",
        "content",
        "focusPoint",
        "importance",
        "dailyTotalKcal",
        "dailyTotalProteinG",
        "dailyTotalFatG",
        "dailyTotalCarbsG",
        "estimatedEnergyDeficitKcal",
        "meals"
      ],
      "additionalProperties": false,
      "properties": {
        "itemType": {
          "const": "dailyMealPlan"
        },
        "day": {
          "$ref": "#/$defs/dayValue"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "content": {
          "type": "string",
          "minLength": 1
        },
        "focusPoint": {
          "type": "string",
          "minLength": 1
        },
        "importance": {
          "$ref": "#/$defs/importance"
        },
        "dailyTotalKcal": {
          "$ref": "#/$defs/numberValue"
        },
        "dailyTotalProteinG": {
          "$ref": "#/$defs/numberValue"
        },
        "dailyTotalFatG": {
          "$ref": "#/$defs/numberValue"
        },
        "dailyTotalCarbsG": {
          "$ref": "#/$defs/numberValue"
        },
        "estimatedEnergyDeficitKcal": {
          "$ref": "#/$defs/numberValue"
        },
        "meals": {
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "#/$defs/meal"
          }
        }
      }
    },
    "meal": {
      "type": "object",
      "required": [
        "mealName",
        "mealScene",
        "mealTotalKcal",
        "mealTotalProteinG",
        "mealTotalFatG",
        "mealTotalCarbsG",
        "foods"
      ],
      "additionalProperties": false,
      "properties": {
        "mealScene": {
          "type": "string"
        },
        "mealName": {
          "type": "string",
          "minLength": 1
        },
        "mealTotalKcal": {
          "$ref": "#/$defs/numberValue"
        },
        "mealTotalProteinG": {
          "$ref": "#/$defs/numberValue"
        },
        "mealTotalFatG": {
          "$ref": "#/$defs/numberValue"
        },
        "mealTotalCarbsG": {
          "$ref": "#/$defs/numberValue"
        },
        "foods": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/food"
          }
        }
      }
    },
    "food": {
      "type": "object",
      "required": [
        "name",
        "amountG",
        "kcal",
        "proteinG",
        "fatG",
        "carbsG"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "amountG": {
          "$ref": "#/$defs/numberValue"
        },
        "kcal": {
          "$ref": "#/$defs/numberValue"
        },
        "proteinG": {
          "$ref": "#/$defs/numberValue"
        },
        "fatG": {
          "$ref": "#/$defs/numberValue"
        },
        "carbsG": {
          "$ref": "#/$defs/numberValue"
        }
      }
    }
  }
}
