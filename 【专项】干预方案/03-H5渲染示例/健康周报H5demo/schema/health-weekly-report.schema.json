{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HealthWeeklyReportFinalPlan",
  "type": "object",
  "required": [
    "planName",
    "planTitle",
    "planSummary",
    "executionPoints",
    "groups"
  ],
  "properties": {
    "planName": {
      "description": "Dify 生成的周报名称，健康周报分支固定为“健康周报”。",
      "type": "string"
    },
    "planTitle": {
      "description": "Dify 节点4生成的封面卡标题。",
      "type": "string"
    },
    "planSummary": {
      "description": "Dify 节点4生成的封面卡正文概述。",
      "type": "string"
    },
    "executionPoints": {
      "description": "Dify 节点4生成的末屏执行要点。",
      "type": "string"
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "groupTitle",
          "groupType",
          "groupSummary",
          "displayStyle",
          "dietPlanGoalLabel",
          "goalBasis",
          "items"
        ],
        "properties": {
          "groupTitle": {
            "type": "string"
          },
          "groupType": {
            "type": "string"
          },
          "groupSummary": {
            "type": "string"
          },
          "displayStyle": {
            "type": "string"
          },
          "dietPlanGoalLabel": {
            "type": "string"
          },
          "goalBasis": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "itemType",
                "day",
                "title",
                "content",
                "focusPoint",
                "importance",
                "dailyTotalKcal",
                "dailyTotalProteinG",
                "dailyTotalFatG",
                "estimatedEnergyDeficitKcal",
                "meals"
              ],
              "properties": {
                "itemType": {
                  "type": "string"
                },
                "day": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "content": {
                  "type": "string"
                },
                "focusPoint": {
                  "type": "string"
                },
                "importance": {
                  "type": "string",
                  "enum": [
                    "重点执行",
                    "常规建议",
                    "补充建议"
                  ]
                },
                "dailyTotalKcal": {
                  "type": "string"
                },
                "dailyTotalProteinG": {
                  "type": "string"
                },
                "dailyTotalFatG": {
                  "type": "string"
                },
                "estimatedEnergyDeficitKcal": {
                  "type": "string"
                },
                "meals": {
                  "type": "array"
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
