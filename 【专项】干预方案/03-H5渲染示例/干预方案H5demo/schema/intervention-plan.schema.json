{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Intervention Plan H5 Demo Schema",
  "type": "object",
  "required": [
    "plan_name",
    "plan_title",
    "plan_summary",
    "execution_points",
    "groups"
  ],
  "additionalProperties": false,
  "properties": {
    "plan_name": {
      "type": "string",
      "minLength": 1
    },
    "plan_title": {
      "type": "string",
      "minLength": 1
    },
    "plan_summary": {
      "type": "string"
    },
    "execution_points": {
      "type": "string"
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/adviceGroup"
          },
          {
            "$ref": "#/$defs/weeklyMealPlanGroup"
          }
        ]
      }
    }
  },
  "$defs": {
    "importance": {
      "type": "string",
      "enum": [
        "重点执行",
        "常规建议",
        "补充建议"
      ]
    },
    "numberValue": {
      "type": "number"
    },
    "adviceGroup": {
      "type": "object",
      "required": [
        "group_title",
        "group_type",
        "group_summary",
        "display_style",
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "group_title": {
          "type": "string",
          "minLength": 1
        },
        "group_type": {
          "const": "advice_list"
        },
        "group_summary": {
          "type": "string"
        },
        "display_style": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/adviceItem"
          }
        }
      }
    },
    "adviceItem": {
      "type": "object",
      "required": [
        "item_type",
        "content",
        "focus_point",
        "importance"
      ],
      "additionalProperties": false,
      "properties": {
        "item_type": {
          "const": "advice"
        },
        "title": {
          "type": "string"
        },
        "content": {
          "type": "string",
          "minLength": 1
        },
        "focus_point": {
          "type": "string",
          "minLength": 1
        },
        "importance": {
          "$ref": "#/$defs/importance"
        }
      }
    },
    "weeklyMealPlanGroup": {
      "type": "object",
      "required": [
        "group_title",
        "group_type",
        "group_summary",
        "display_style",
        "diet_plan_goal_label",
        "goal_basis",
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "group_title": {
          "type": "string",
          "minLength": 1
        },
        "group_type": {
          "const": "weekly_meal_plan"
        },
        "group_summary": {
          "type": "string"
        },
        "display_style": {
          "const": "weekly_meal_plan"
        },
        "diet_plan_goal_label": {
          "type": "string",
          "minLength": 1
        },
        "goal_basis": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {
            "$ref": "#/$defs/dailyMealPlanItem"
          }
        }
      }
    },
    "dailyMealPlanItem": {
      "type": "object",
      "required": [
        "item_type",
        "day",
        "title",
        "content",
        "focus_point",
        "importance",
        "daily_total_kcal",
        "daily_total_protein_g",
        "daily_total_fat_g",
        "estimated_energy_deficit_kcal",
        "meals"
      ],
      "additionalProperties": false,
      "properties": {
        "item_type": {
          "const": "daily_meal_plan"
        },
        "day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "content": {
          "type": "string",
          "minLength": 1
        },
        "focus_point": {
          "type": "string",
          "minLength": 1
        },
        "importance": {
          "$ref": "#/$defs/importance"
        },
        "daily_total_kcal": {
          "$ref": "#/$defs/numberValue"
        },
        "daily_total_protein_g": {
          "$ref": "#/$defs/numberValue"
        },
        "daily_total_fat_g": {
          "$ref": "#/$defs/numberValue"
        },
        "estimated_energy_deficit_kcal": {
          "$ref": "#/$defs/numberValue"
        },
        "meals": {
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "#/$defs/meal"
          }
        }
      }
    },
    "meal": {
      "type": "object",
      "required": [
        "meal_name",
        "meal_total_kcal",
        "meal_total_protein_g",
        "meal_total_fat_g",
        "foods"
      ],
      "additionalProperties": false,
      "properties": {
        "meal_scene": {
          "type": "string"
        },
        "meal_name": {
          "type": "string",
          "minLength": 1
        },
        "meal_total_kcal": {
          "$ref": "#/$defs/numberValue"
        },
        "meal_total_protein_g": {
          "$ref": "#/$defs/numberValue"
        },
        "meal_total_fat_g": {
          "$ref": "#/$defs/numberValue"
        },
        "foods": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/food"
          }
        }
      }
    },
    "food": {
      "type": "object",
      "required": [
        "name",
        "amount_g",
        "kcal",
        "protein_g",
        "fat_g"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "amount_g": {
          "$ref": "#/$defs/numberValue"
        },
        "kcal": {
          "$ref": "#/$defs/numberValue"
        },
        "protein_g": {
          "$ref": "#/$defs/numberValue"
        },
        "fat_g": {
          "$ref": "#/$defs/numberValue"
        }
      }
    }
  }
}
